<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="clr-namespace:EquipmentBorrowing.Domain;assembly=EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentManagementView" x:DataType="vm:EquipmentManagementViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
        <StackPanel Spacing="5"><TextBlock Text="Equipment Management" Classes="pageTitle"/><TextBlock Text="Keep your equipment catalog organized and up to date." Classes="subtitle"/></StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Find by equipment identifier or name"/>
            <Button Grid.Column="1" Content="Search / Refresh" Command="{Binding RefreshCommand}"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="22">
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedEquipment}" IsEnabled="{Binding CanEdit}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Equipment">
                        <StackPanel Margin="0" Spacing="6">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding EquipmentIdentifier}"/>
                            <StackPanel><TextBlock Text="Available" IsVisible="{Binding IsAvailable}" Foreground="#08786C" FontWeight="Medium" FontSize="12"/><TextBlock Text="On loan" IsVisible="{Binding !IsAvailable}" Foreground="#9A6118" FontWeight="Medium" FontSize="12"/></StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Classes="card"><ScrollViewer>
                <StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
                    <Button Content="New equipment" Command="{Binding NewEquipmentCommand}"/>
                    <TextBlock Text="Equipment identifier (required)"/>
                    <TextBox Text="{Binding EquipmentIdentifier}"/>
                    <TextBlock Text="Name (required)"/>
                    <TextBox Text="{Binding Name}"/>
                    <TextBlock Text="Description/type (optional; blank clears it)" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="60"/>
                    <Button Classes="primary" Content="Register equipment" Command="{Binding RegisterCommand}"/>
                    <Button Content="Save selected item's details" Command="{Binding SaveChangesCommand}"/>
                    <TextBlock Text="{Binding AvailabilityText}" TextWrapping="Wrap"/>
                    <TextBlock Text="Availability is read-only here. Borrowing and returns control transaction state." TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer></Border>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="5">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
            <TextBlock Text="{Binding LoadMessage}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="Medium"/>
        </StackPanel>
    </Grid>
</UserControl>
