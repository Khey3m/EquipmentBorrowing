<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:app="clr-namespace:EquipmentBorrowing.Application.Interfaces;assembly=EquipmentBorrowing.Application"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingHistoryView" x:DataType="vm:BorrowingHistoryViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <TextBlock Text="Borrowing Histories" FontSize="20" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="History for:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"/>
            <Button Content="Refresh subjects" Command="{Binding RefreshCommand}"/>
            <Button Content="Retry selected history" Command="{Binding RetryHistoryCommand}"/>
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,2*" ColumnSpacing="15">
            <StackPanel>
                <TextBlock Text="{Binding SubjectMessage}" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" MaxHeight="360">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="app:HistorySubject"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="{Binding CurrentSubjectLabel}" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{Binding HistoryMessage}" TextWrapping="Wrap"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding Rows}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="app:BorrowingDetails">
                            <StackPanel Margin="5" Spacing="3">
                                <TextBlock Text="{Binding Id, StringFormat='Borrowing #{0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding StudentName}"/>
                                <TextBlock Text="{Binding StudentNumber}"/>
                                <TextBlock Text="{Binding EquipmentName}"/>
                                <TextBlock Text="{Binding EquipmentIdentifier}"/>
                                <TextBlock Text="{Binding CheckoutDate, StringFormat='Checkout: {0:yyyy-MM-dd}'}"/>
                                <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Expected return: {0:yyyy-MM-dd}'}"/>
                                <TextBlock Text="{Binding ActualReturnDate, StringFormat='Actual return: {0:yyyy-MM-dd}', TargetNullValue='Actual return: pending'}"/>
                                <TextBlock Text="{Binding Status}" FontWeight="Medium"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
        <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding IsLoading}"/>
    </Grid>
</UserControl>
