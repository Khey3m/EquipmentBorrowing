<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:app="clr-namespace:EquipmentBorrowing.Application.Interfaces;assembly=EquipmentBorrowing.Application"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingHistoryView" x:DataType="vm:BorrowingHistoryViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
        <StackPanel Spacing="5"><TextBlock Text="Borrowing Histories" Classes="pageTitle"/><TextBlock Text="Follow the complete borrowing history of a student or item." Classes="subtitle"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="History for:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"/>
            <Button Content="Refresh subjects" Command="{Binding RefreshCommand}"/>
            <Button Content="Retry selected history" Command="{Binding RetryHistoryCommand}"/>
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*,2*" ColumnSpacing="22">
            <StackPanel>
                <TextBlock Text="{Binding SubjectMessage}" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}" MaxHeight="360">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="app:HistorySubject"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="{Binding CurrentSubjectLabel}" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Text="{Binding HistoryMessage}" TextWrapping="Wrap"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding Rows}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="app:BorrowingDetails">
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="18" Margin="0,4">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StudentNumber}" Classes="subtitle"/>
                            <TextBlock Text="{Binding Id, StringFormat='LOAN #{0}'}" Foreground="#087F8C" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{Binding EquipmentName}" FontWeight="Medium" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EquipmentIdentifier}" Classes="subtitle"/>
                            <TextBlock Text="{Binding CheckoutDate, StringFormat='Issued: {0:yyyy-MM-dd}'}" Classes="subtitle"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="7" MinWidth="145">
                            <Border Background="#E5F3F1" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Foreground="#146B64" FontSize="11" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:yyyy-MM-dd}'}" FontWeight="Medium"/>
                            <TextBlock Text="{Binding ActualReturnDate, StringFormat='Returned: {0:yyyy-MM-dd}', TargetNullValue='Return pending'}" Classes="subtitle"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
        <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding IsLoading}"/>
    </Grid>
</UserControl>
