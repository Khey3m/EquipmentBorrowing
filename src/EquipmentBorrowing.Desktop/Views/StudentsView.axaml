<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="clr-namespace:EquipmentBorrowing.Domain;assembly=EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.StudentsView" x:DataType="vm:StudentsViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <TextBlock Text="Student Management" FontSize="20" FontWeight="Bold"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding SearchText}" PlaceholderText="Find by institutional number or full name"/>
            <Button Grid.Column="1" Content="Search / Refresh" Command="{Binding RefreshCommand}"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15">
            <ListBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" IsEnabled="{Binding CanEdit}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Student">
                        <StackPanel Margin="5" Spacing="3">
                            <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StudentNumber}"/>
                            <TextBlock Text="{Binding IsEligibleToBorrow, StringFormat='Eligible: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
                    <Button Content="New student" Command="{Binding NewStudentCommand}"/>
                    <TextBlock Text="Institutional student number (required)"/>
                    <TextBox Text="{Binding StudentNumber}"/>
                    <TextBlock Text="Full name (required)"/>
                    <TextBox Text="{Binding FullName}"/>
                    <TextBlock Text="Contact information (optional; blank clears it)" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding ContactInformation}"/>
                    <Button Content="Register student" Command="{Binding RegisterCommand}"/>
                    <Button Content="Save selected student's details" Command="{Binding SaveChangesCommand}"/>
                    <TextBlock Text="{Binding EligibilityText}" TextWrapping="Wrap"/>
                    <Button Content="Permit borrowing" Command="{Binding PermitCommand}"/>
                    <Button Content="Restrict new borrowing" Command="{Binding RestrictCommand}"/>
                    <TextBlock Text="Eligibility changes preserve existing loans and allow returns." TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="5">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
            <TextBlock Text="{Binding LoadMessage}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="Medium"/>
        </StackPanel>
    </Grid>
</UserControl>
