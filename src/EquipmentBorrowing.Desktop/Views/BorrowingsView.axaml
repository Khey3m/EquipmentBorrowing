<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:app="clr-namespace:EquipmentBorrowing.Application.Interfaces;assembly=EquipmentBorrowing.Application"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView" x:DataType="vm:BorrowingsViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="15">
            <StackPanel Spacing="5"><TextBlock Text="Active Borrowings" Classes="pageTitle"/><TextBlock Text="Review outstanding equipment and confirm student returns." Classes="subtitle"/></StackPanel>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedBorrowing}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:BorrowingDetails">
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="18" Margin="0,4">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StudentNumber}" Classes="subtitle"/>
                            <TextBlock Text="{Binding Id, StringFormat='LOAN #{0}'}" Foreground="#087F8C" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{Binding EquipmentName}" FontWeight="Medium" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EquipmentIdentifier}" Classes="subtitle"/>
                            <TextBlock Text="{Binding CheckoutDate, StringFormat='Issued: {0:yyyy-MM-dd}'}" Classes="subtitle"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="7" MinWidth="145">
                            <Border Background="#E5F3F1" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Foreground="#146B64" FontSize="11" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:yyyy-MM-dd}'}" FontWeight="Medium"/>

                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <CheckBox Content="Confirm return of the selected item" IsChecked="{Binding ConfirmReturn}"/>
            <Button Classes="primary" Content="Return selected item" Command="{Binding ReturnCommand}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="5">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
            <TextBlock Text="{Binding LoadMessage}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="Medium"/>
        </StackPanel>
    </Grid>
</UserControl>
