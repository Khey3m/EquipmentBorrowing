    "/api/v1/borrowings": {
      "get": {
        "tags": [
          "Borrowings"
        ],
        "summary": "Search/filter/sort history; default All, borrowedDate, asc; ties use ID ascending",
        "operationId": "API-14",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Trimmed case-insensitive partial match on student name/number or equipment name; literal %, _ and backslash.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "enum": [
                "All",
                "Active",
                "Returned"
              ],
              "type": "string",
              "default": "All"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "enum": [
                "borrowedDate",
                "expectedReturnDate"
              ],
              "type": "string",
              "default": "borrowedDate"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BorrowingResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
